{
    "name": "pr4w/cashier-tracker",
    "description": "Tracks Laravel Cashier (Stripe) payments locally.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/cashier": "^15.0|^16.0",
        "stripe/stripe-php": "^13.0|^16.2|^17.3|^18.0|^19.0|^20.0|^21.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Pr4w\\CashierTracker\\": "src/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pr4w\\CashierTracker\\CashierTrackerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Pr4w\\CashierTracker\\Tests\\": "tests/"
        }
    }
}
